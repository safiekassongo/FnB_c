# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API from a browser.
# Example: ALLOWED_ORIGINS=https://forwardinbusiness.co.tz,https://www.forwardinbusiness.co.tz
# Leave empty only for local testing.
ALLOWED_ORIGINS=

# Comma-separated list of valid publisher tokens. Give each publisher
# their own token so you can revoke one individually later.
# Generate a strong one with: node -e "console.log(require('crypto').randomUUID())"
PUBLISHER_TOKENS=

# Where the SQLite database file is stored. Defaults to ./data/fnb.db
# if unset. On most hosts, point this at a persistent volume/disk —
# without one, the database resets on every redeploy.
DATABASE_PATH=./data/fnb.db
